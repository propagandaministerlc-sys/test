{
  "id": "com.surfacebrush.photoshop",
  "name": "Surface Brush",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "PS",
    "minVersion": "24.4.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "surfaceBrushPanel",
      "label": {
        "default": "Surface Brush"
      },
      "minimumSize": { "width": 240, "height": 360 },
      "maximumSize": { "width": 600, "height": 2000 },
      "preferredDockedSize": { "width": 280, "height": 520 },
      "preferredFloatingSize": { "width": 300, "height": 560 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/dark.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/light.png", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium", "lightest", "light", "all"], "species": ["pluginList"] }
  ]
}
